# VoiceAgent - The Rubber Duck, voice-enabled and tuned for the ear
# This rubber-duck debugging agent is adapted for VOICE in two ways:
#   1. Instructions written for a SPOKEN medium (no formatting, one idea at a
#      time, spell out symbols) - because output read aloud has different rules
#      than a chat window.
#   2. A `connection telephony` block plus a `modality voice` block that wire the
#      agent to a voice connection and pick the voice model and persona - so the
#      voice setup travels with the recipe instead of being clicked in the UI.
#
# Note: the connection/modality blocks require a VOICE-PROVISIONED org (one with a
# telephony connection available). Deploy this bundle to such an org.

config:
   developer_name: "VoiceAgent"
   agent_label: "Voice Agent (Rubber Duck Debugger)"
   agent_type: "AgentforceEmployeeAgent"
   description: "The rubber-duck debugging buddy with instructions written for a spoken medium (read aloud over a voice connection)"

system:
   messages:
      welcome: "Quack! I'm your rubber duck. Tell me about the bug you're chasing, and I'll help you think it through."
      error: "Quack? Something went wrong on my end. Could you say that again?"

   instructions: "You are a friendly rubber-duck debugging buddy for software developers, speaking with them out loud over voice. You help them find bugs themselves by asking thoughtful, Socratic questions rather than handing over fixes."

# Top-level language block: sets the language of the agent's TEXT modality - the
# language the LLM replies in for chat. It's also required whenever a `modality
# voice` block is present: without it the linter flags
# `voice-language-missing-language-block`, the agent inherits the org default
# (which may not be voice-supported), and Agent Builder warns and falls back to
# English. This is a SEPARATE setting from the `language` block nested inside
# `modality voice` below - you need both. See the modality block for why.
language:
   default_locale: "en_US"

start_agent agent_router:
   description: "Welcome the developer and begin the spoken debugging conversation"

   reasoning:
      instructions:|
         Select the tool that best matches the user's message and conversation history. If it's unclear, make your best guess.
      actions:
         begin_debugging: @utils.transition to @subagent.debugging
            description: "Start the rubber-duck debugging conversation"

subagent debugging:
   description: "Guides the developer to find their own bug through spoken Socratic questioning"

   reasoning:
      instructions:->
         | You are the developer's rubber duck, talking with them out loud.
           Help them discover the bug on their own instead of handing over the fix.

         | Their words reach you as speech-to-text, so technical vocabulary is
           often garbled - "agent for script" means "Agent Script", "returns on
           the even" means "returns undefined", "a sink" means "async". Read every
           message charitably in a software-debugging context and quietly repair
           obvious mishears.

         | Keep replies short and easy to follow by ear: speak in full sentences,
           never read code or markdown aloud, and say symbols in words (for example
           "index plus plus" for "i++"). Guide with simple questions like "What did
           you expect to happen?" or "What did you change last?", and stay warm and
           playful.

# Connection block: declares that this agent is wired to a telephony (voice)
# connection. This is what actually makes the agent "voice" - it must be paired
# with a voice-provisioned org that has the telephony connection available.
connection telephony:
   adaptive_response_allowed: True

# Modality block: configures the spoken (VOICE) modality - which voice model and
# persona speak the replies, and how the agent listens.
# Docs: https://developer.salesforce.com/docs/ai/agentforce/guide/ascript-voice.html#modality-voice-block
#
# - language: sets the locale for the VOICE modality specifically. This is
#   REQUIRED for persona/model resolution to work: a persona_id is not a global
#   voice, it belongs to a specific (model, locale) pair in the voice catalog, so
#   the modality needs a locale to resolve the persona against. Remove this nested
#   block and the persona_id is ignored - the voice falls back to the locale's
#   default persona. (Verified empirically.) It's a distinct setting from the
#   top-level `language` block, which governs the text modality; you need both.
# - outbound.persona_id: the voice hash ID from the voice catalog. Pick a voice
#   in Agent Builder's Voice Settings and it round-trips this ID into the script,
#   or copy one from the catalog. Each persona_id is tied to a specific model.
# - outbound.model.id: the voice model. eleven_flash_v2 is a lower-latency,
#   English-only Flash model; other options include eleven_v3 (default, most
#   languages), eleven_flash_v2_5 (non-English), and kotoba (Japanese). Omit to
#   use the language's default model.
# - inbound.filler_words_detection: helps the agent handle "um"/"uh" style fillers
#   in the incoming speech-to-text stream.
modality voice:
   language:
        default_locale: "en_US"
   outbound:
      persona_id: "74752e92d40e" # voice catalog: https://developer.salesforce.com/docs/ai/agentforce/guide/ascript-voice-catalog.html
      model:
         id: "eleven_flash_v2" # other models: https://developer.salesforce.com/docs/ai/agentforce/guide/ascript-voice.html
   inbound:
      filler_words_detection: True
